# Оставьте пустым — запросы пойдут на Next.js `/api/*` и проксируются на Django (см. next.config.ts).
# Либо укажите прямой URL API (нужен CORS на бэкенде):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# @username бота без @ — для реферальной ссылки в профиле мини-приложения:
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
